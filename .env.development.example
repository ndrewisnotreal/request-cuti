# ==============================
# SiCuti frontend - development environment (example)
# Salin menjadi .env.development
# ==============================

# Nest API via Vite proxy `/api` → http(s)://localhost:3001 (prefix di-strip).
# Backend harus berjalan di PORT=3001 (lihat backend/.env.development).
VITE_API_BASE_URL=/api

# Sent as the `x-api-key` header on every request. Must match the backend's
# API_TOKEN value.
VITE_APP_KEY=change-me

# Local-only secret used to AES-encrypt session/menu/akses in localStorage.
# Must be exactly 32 characters. Not related to the backend's AES_KEY.
VITE_ENCRYPTION_SECRET_KEY=changeme-encryption-secret-32chr

# Base path Vite/router. Dev lokal: `/`. Deploy Traefik path `/cuti`: `/cuti/`.
VITE_BASE_URL=/

# Opsional: alamat aplikasi yang ditulis di QR surat cuti (mis. http://192.168.1.23:5175).
# Kosong = alamat yang sedang dibuka di browser.
VITE_PUBLIC_APP_URL=
